# Copy to .env and adjust. Both docker compose and the app read .env automatically; variables
# already set in the environment take precedence.

# Database (used by docker-compose.yml and the app).
TASKBOARD_DB_HOST=localhost
TASKBOARD_DB_PORT=5432
TASKBOARD_DB_NAME=taskboard
TASKBOARD_DB_USER=taskboard
TASKBOARD_DB_PASSWORD=change-me
# Alternatively, a full SQLAlchemy URL; it takes precedence over the TASKBOARD_DB_* parts above.
# TASKBOARD_DATABASE_URL=postgresql+psycopg://taskboard:change-me@localhost:5432/taskboard

# File storage: any S3-compatible service; the defaults match the rustfs service in docker-compose.yml.
TASKBOARD_S3_ENDPOINT_URL=http://localhost:9000
TASKBOARD_S3_BUCKET=taskboard
TASKBOARD_S3_ACCESS_KEY=taskboard
TASKBOARD_S3_SECRET_KEY=change-me
# TASKBOARD_S3_REGION=us-east-1
# Host ports for docker compose: the S3 API and RustFS's web console.
# TASKBOARD_S3_PORT=9000
# TASKBOARD_S3_CONSOLE_PORT=9001
# Host port for the app in docker compose.
# TASKBOARD_PORT=8501

# Login: the administrator signs in with this login/password and can open the admin panel;
# everyone else signs in with OIDC (start with `streamlit run asgi_app.py`) and gets their own account.
# TASKBOARD_LOGIN=admin
# TASKBOARD_PASSWORD=change-me
# TASKBOARD_OIDC_CLIENT_ID=
# TASKBOARD_OIDC_CLIENT_SECRET=
# TASKBOARD_OIDC_SERVER_METADATA_URL=
# TASKBOARD_OIDC_REDIRECT_URI=http://localhost:8501/oauth2callback
# TASKBOARD_OIDC_COOKIE_SECRET=
# TASKBOARD_AUTH_DISABLED=1
